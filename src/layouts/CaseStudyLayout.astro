---
import { getCollection } from 'astro:content';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.jsx';
import TableOfContents from '../components/TableOfContents.jsx';
import CaseStudyMeta from '../components/CaseStudyMeta.astro';
import StatRow from '../components/StatRow.astro';
import StatCard from '../components/StatCard.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description: string;
  date: Date;
  skills: string[];
  role: string;
  timeline: string;
  team: string;
  outcome: string;
  heroImage?: string;
  heroAlt?: string;
  metrics?: { value: string; context?: string; label: string }[];
}

const { title, description, date, role, timeline, team, outcome, heroImage, heroAlt, metrics } = Astro.props;
const skills = Astro.props.skills || [];

const formattedDate = date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});

const rawCaseStudies = await getCollection('case-studies', ({ data }) => !data.draft);
const caseStudies = rawCaseStudies.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
).map(study => ({
  slug: study.id,
  title: study.data.title,
}));

// Next case study (wraps around)
const currentIndex = caseStudies.findIndex(s => s.title === title);
const nextStudy = caseStudies.length > 1 ? caseStudies[(currentIndex + 1) % caseStudies.length] : null;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title} — John Pechacek</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — John Pechacek`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="article" />
    <meta property="og:image" content={`${Astro.site ?? Astro.url.origin}/images/headshot.png`} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Afacad:wght@400;500;600;700&family=Alegreya:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/main.css">
    <ClientRouter />
    <script data-goatcounter="https://johnapechacek.goatcounter.com/count" data-goatcounter-settings='{"no_onload": true}' async src="//gc.zgo.at/count.js"></script>
    <script>
      document.addEventListener('astro:page-load', () => window.goatcounter?.count());
    </script>
  </head>
  <body>
    <Header client:load caseStudies={caseStudies} currentPath={Astro.url.pathname} transition:persist />
    <div class="case-study-intro">
      <h1>{title}</h1>
      {heroImage && (
        <img class="case-study-hero" src={heroImage} alt={heroAlt ?? ''} />
      )}
      <CaseStudyMeta role={role} timeline={timeline} team={team} skills={skills} />
      <p class="case-study-outcome">{outcome}</p>
      {metrics && metrics.length > 0 && (
        <StatRow>
          {metrics.map(m => (
            <StatCard value={m.value} context={m.context} label={m.label} />
          ))}
        </StatRow>
      )}
    </div>
    <div class="case-study-wrapper">
      <aside class="toc-sidebar" transition:name="toc-sidebar">
        <TableOfContents client:load />
      </aside>
      <main class="case-study-content">
        <article>
          <slot />
        </article>
        {nextStudy && (
          <nav class="next-case-study">
            <span class="next-kicker">next case study</span>
            <a href={`/case-studies/${nextStudy.slug}`} class="next-title">
              {nextStudy.title}
            </a>
          </nav>
        )}
        <Footer />
      </main>
    </div>
  </body>
</html>

<style is:global>
  /* Full-width intro zone above two-column body */
  .case-study-intro {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2.5rem 3rem 2rem;
    border-bottom: 1px solid var(--mg-2);
  }

  .case-study-hero {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 0.5rem;
    margin: 1.5rem 0;
  }

  .case-study-outcome {
    margin: 0 0 0.5rem;
    max-width: 72ch;
  }

  @media (max-width: 900px) {
    .case-study-intro {
      padding: 1.5rem 2rem 1.5rem;
    }
  }

  /* Case study two-column layout */
  .case-study-wrapper {
    display: grid;
    grid-template-columns: 320px 1fr;
    min-height: calc(100vh - 3rem);
    max-width: 1400px;
    margin: 0 auto;
  }

  .toc-sidebar {
    position: sticky;
    top: 3rem;
    height: calc(100vh - 3rem);
    overflow-y: auto;
    padding: 2rem 1.5rem;
    border-right: 1px solid var(--mg-2);
  }

  .case-study-content {
    padding: 2rem 3rem;
    min-width: 0;
  }

  .case-study-content article {
    max-width: 72ch;
  }

  @media (max-width: 900px) {
    .case-study-wrapper {
      grid-template-columns: 1fr;
    }

    .toc-sidebar {
      display: none;
    }

    .case-study-content {
      padding: 2rem;
    }
  }

  /* Table of contents */
  .toc-list,
  .toc-sub-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .toc-sub-list {
    margin-left: 0.75rem;
    border-left: 1px solid var(--mg-2);
  }

  .toc-sub-item {
    position: relative;
    padding-left: 1rem;
  }

  .toc-sub-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.65rem;
    height: 1px;
    background-color: var(--mg-2);
    transform: translateY(-50%);
  }

  .toc-link {
    display: block;
    width: 100%;
    background: none;
    border: none;
    cursor: pointer;
    text-align: left;
    padding: 0.3rem 0;
    font-family: "Afacad", sans-serif;
    font-size: 1.25rem;
    color: var(--fg-1);
    line-height: 1.3;
    transition: color 0.15s;
  }

  .toc-link:hover {
    color: var(--fg-3);
  }

  .toc-text {
    background-image: linear-gradient(currentColor, currentColor);
    background-position: 0% 100%;
    background-repeat: no-repeat;
    background-size: 0% 1px;
    transition: background-size 0.3s ease;
  }

  .toc-link.active .toc-text {
    background-size: 100% 1px;
  }

  .toc-h3 {
    font-size: 1.1rem;
    padding: 0.2rem 0;
  }

  @keyframes toc-slide-in {
    from { transform: translateX(-100%); }
    to   { transform: translateX(0); }
  }

/* Enter: slide in (no old counterpart = coming from non-case-study page) */
  ::view-transition-new(toc-sidebar):only-child {
    animation: toc-slide-in 0.45s cubic-bezier(0, 1.38, 0.51, 0.97);
  }

  /* Morph (case study → case study): hide old immediately, show new immediately */
  ::view-transition-old(toc-sidebar):not(:only-child) {
    animation: none;
    opacity: 0;
  }
  ::view-transition-new(toc-sidebar):not(:only-child) {
    animation: none;
  }

  /* Next case study nav */
  .next-case-study {
    border-top: 1px solid var(--mg-2);
    margin-top: 3rem;
    padding-top: 2rem;
    padding-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .next-kicker {
    font-family: "Afacad", sans-serif;
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--fg-1);
    text-transform: lowercase;
    letter-spacing: 0.04em;
  }

  .next-title {
    font-family: "Afacad", sans-serif;
    font-size: 2rem;
    font-weight: 600;
    color: var(--fg-3);
    text-decoration: none;
    line-height: 1.2;
    transition: color 0.15s;
  }

  .next-title:hover {
    color: var(--accent);
  }

  /* Section scroll-in animation */
  .section-animate {
    transition: opacity 0.5s ease-out, transform 0.5s ease-out;
  }

  .section-animate.section-hidden {
    opacity: 0;
    transform: translateY(1.25rem);
  }
</style>

<script>
  function initSectionAnimations() {
    const article = document.querySelector('.case-study-content article');
    if (!article) return;

    const elements = article.querySelectorAll(':scope > *');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            entry.target.classList.remove('section-hidden');
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.1 }
    );

    elements.forEach((el) => {
      const rect = el.getBoundingClientRect();
      const inViewport = rect.top < window.innerHeight && rect.bottom >= 0;

      el.classList.add('section-animate');

      if (!inViewport) {
        el.classList.add('section-hidden');
        observer.observe(el);
      }
    });
  }

  document.addEventListener('astro:page-load', initSectionAnimations);
</script>
