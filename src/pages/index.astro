---
import { getEntry, render, getCollection } from 'astro:content';
import PageLayout from '../layouts/PageLayout.astro';

const about = await getEntry('about', 'index');
const { Content } = await render(about);

const rawCaseStudies = await getCollection('case-studies', ({ data }) => !data.draft);
const caseStudies = rawCaseStudies.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// Pull the featured studies by slug
const buckList = caseStudies.find(s => s.id === 'designing-buck-list');
const featured = [buckList].filter(Boolean);
---

<PageLayout title="John Pechacek — Senior UX Designer">
  <!-- Hero lockup -->
  <section class="hero">
    <div class="hero-text">
      <h1 class="hero-name">John Pechacek</h1>
      <p class="hero-role">Senior UX Designer</p>
    </div>
    <div class="hero-headshot-wrap">
      <img src="/images/headshot.png" alt="John Pechacek" class="hero-headshot" />
    </div>
  </section>

  <!-- About prose (h2 + paragraphs from markdown) -->
  <section class="about-section">
    <div class="about-text">
      <Content />
    </div>
  </section>

  <!-- Featured work -->
  <section class="featured-work">
    <h2 class="section-label">my work</h2>
    <div class="work-cards">
      {featured.map((study) => {
        const hasThumbnail = study.id === 'designing-buck-list';
        return (
          <a href={`/case-studies/${study.id}`} class="work-card">
            {hasThumbnail && (
              <div class="work-card-thumb">
                <img src="/images/bucklist-hero.png" alt={study.data.title} class="work-card-img" />
              </div>
            )}
            <div class="work-card-body">
              <h3 class="work-card-title">{study.data.title}</h3>
              <p class="work-card-desc">{study.data.description}</p>
              <span class="work-card-link">View case study →</span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
</PageLayout>

<style is:global>
  /* ── Hero ─────────────────────────────────────────────────────── */
  .hero {
    display: flex;
    flex-direction: row;
    align-items: center;
    gap: 3rem;
    padding: 3rem 0 3rem;
  }

  .hero-text {
    flex: 1;
    min-width: 0;
  }

  .hero-name {
    font-family: "Afacad", sans-serif;
    font-size: 3.2rem;
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--fg-3);
    margin: 0 0 0.35rem;
  }

  .hero-role {
    font-family: "Afacad", sans-serif;
    font-size: 1.15rem;
    font-weight: 500;
    color: var(--accent);
    margin: 0 0 1rem;
    text-transform: lowercase;
    letter-spacing: 0.03em;
  }

  .hero-headshot-wrap {
    flex-shrink: 0;
    width: 200px;
    height: 200px;
  }

  .hero-headshot {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 50%;
    display: block;
  }

  @media (max-width: 900px) {
    .hero {
      flex-direction: column-reverse;
      align-items: center;
      text-align: center;
      gap: 1.75rem;
      padding: 2rem 0 2rem;
    }

    .hero-text {
      display: flex;
      flex-direction: column;
      align-items: center;
    }

    .hero-headshot-wrap {
      width: 160px;
      height: 160px;
    }
  }

  /* ── Featured work ────────────────────────────────────────────── */
  .featured-work {
    padding: 0 0 3rem;
  }

  .section-label {
    font-family: "Afacad", sans-serif;
    font-size: 2rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    color: var(--fg-3);
    margin: 0 0 1.25rem;
  }

  .work-cards {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .work-card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    cursor: pointer;
  }

  .work-card *,
  .work-card *::before,
  .work-card *::after {
    cursor: pointer;
  }

  .work-card-thumb {
    width: 100%;
    border-radius: 0.75rem;
    overflow: hidden;
  }

  .work-card-img {
    width: 100%;
    height: auto;
    display: block;
    transition: transform 0.4s ease;
  }

  .work-card:hover .work-card-img {
    transform: scale(1.015);
  }

  .work-card-body {
    padding: 1.5rem 0 0;
    max-width: 40rem;
  }

  .work-card-title {
    font-family: "Afacad", sans-serif;
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--fg-3);
    margin: 0 0 0.5rem;
    line-height: 1.2;
  }

  .work-card-desc {
    font-family: "Alegreya", Georgia, serif;
    font-size: 1.1rem;
    line-height: 1.5;
    color: var(--fg-2);
    margin: 0 0 0.6rem;
  }

  .work-card-link {
    display: inline-block;
    font-family: "Afacad", sans-serif;
    font-size: 0.95rem;
    font-weight: 600;
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  .work-card:hover .work-card-link {
    transform: translateX(0.2rem);
  }

  /* ── About section ────────────────────────────────────────────── */
  .about-section {
    padding: 0 0 3rem;
    border-top: 1px solid var(--mg-2);
    padding-top: 2rem;
  }

  .about-text h2 {
    font-family: "Afacad", sans-serif;
    font-size: 2rem;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    color: var(--fg-3);
    margin: 0 0 1.25rem;
  }

  .about-text p {
    font-family: "Alegreya", Georgia, serif;
    font-size: 1.25rem;
    line-height: 1.6;
    color: var(--fg-1);
    margin: 0 0 1.25rem;
    max-width: 52rem;
  }
</style>
