---
interface Props {
  images: { src: string; alt: string }[];
}

const { images } = Astro.props;
---

<div class="screen-group">
  {images.map(image => (
    <img src={image.src} alt={image.alt} class="screen-image" />
  ))}
</div>

<style>
  .screen-group {
    display: flex;
    flex-direction: row;
    gap: 2rem;
  }

  @media (max-width: 900px) {
    .screen-group {
      flex-direction: column;
    }
  }

  .screen-image {
    border-radius: 8px;
    flex: 1;
    min-width: 0;
    height: auto;
  }
</style>
